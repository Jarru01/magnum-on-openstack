{
  "spec": {
    "template": {
      "spec": {
        "initContainers": [
          {
            "name": "install-cni-plugins",
            "image": "busybox:1.36",
            "command": [
              "sh",
              "-c",
              "cd /host/opt/cni/bin/ && wget -qO- https://github.com/containernetworking/plugins/releases/download/v1.3.0/cni-plugins-linux-amd64-v1.3.0.tgz | tar xz && ls"
            ],
            "resources": {}
          }
        ]
      }
    }
  }
}